{
  "opencollection": "1.0.0",
  "info": {
    "name": "Personio Public API v2 Absence Periods Auth API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain an OAuth 2.0 access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.personio.de/v2/auth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange Personio API credentials (Client ID and Client Secret) for a\nshort-lived Bearer access token using the OAuth 2.0 Client Credentials\ngrant.\n"
        }
      ]
    }
  ],
  "bundled": true
}